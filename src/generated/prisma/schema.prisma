generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  clerkId         String          @unique
  email           String          @unique
  name            String?
  age             Int?
  weight          Float?
  goals           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  activityLevel   String?
  height          Float?
  diet_preference String?
  mealPlans       MealPlan[]
  progress        Progress[]
  userRecipes     UserRecipe[]
  recipes         Recipe[]
  preferences     UserPreference?
}

model UserPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  weekStartDay Int      @default(1)
  dayCount     Int      @default(7)
  theme        String   @default("system")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRecipe {
  id             String   @id @default(uuid())
  userId         String
  status         String
  dateAdded      DateTime @default(now())
  cachedRecipeId String?
  sourceId       String?
  cachedRecipe   Recipe?  @relation(fields: [cachedRecipeId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, status])
}

model MealPlan {
  id            String         @id @default(uuid())
  userId        String
  startDate     DateTime
  endDate       DateTime
  constraints   Json?
  createdAt     DateTime       @default(now())
  gridJson      Json?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanItems MealPlanItem[]
}

model MealPlanItem {
  id             String     @id @default(uuid())
  mealPlanId     String
  dayOfWeek      Int
  mealType       String
  cachedRecipeId String?
  sourceId       String?
  dishes         MealDish[]
  cachedRecipe   Recipe?    @relation(fields: [cachedRecipeId], references: [id])
  mealPlan       MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, dayOfWeek, mealType])
}

model MealDish {
  id             String       @id @default(uuid())
  mealPlanItemId String
  recipeId       String
  quantity       Float        @default(1)
  unit           String       @default("serving")
  order          Int          @default(0)
  mealPlanItem   MealPlanItem @relation(fields: [mealPlanItemId], references: [id], onDelete: Cascade)
  recipe         Recipe       @relation(fields: [recipeId], references: [id])

  @@index([mealPlanItemId])
}

model Progress {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime
  weight           Float?
  notes            String?
  createdAt        DateTime @default(now())
  caloriesConsumed Int?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id               String             @id @default(uuid())
  title            String
  description      String?
  imageUrl         String?
  fallbackImageUrl String?
  sourceType       RecipeSourceType
  sourceId         String?
  sourceUrl        String?
  cuisine          String?
  mealType         String?
  difficulty       RecipeDifficulty?
  prepTime         Int?
  cookTime         Int?
  totalTime        Int?
  servings         Int?
  instructions     String[]
  nutrition        Json?
  tags             String[]
  namedEntities    String[]
  userRating       Float?
  savedCount       Int                @default(0)
  isPublic         Boolean            @default(true)
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  cacheTtlSeconds  Int?
  rawApiResponse   Json?
  mealDishes       MealDish[]
  mealPlanItems    MealPlanItem[]
  ingredients      RecipeIngredient[]
  userRecipes      UserRecipe[]
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([title])
  @@index([cuisine])
  @@index([mealType])
  @@index([createdAt])
  @@index([savedCount])
  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  ingredientId Int
  name         String
  amount       Float
  unit         String
  original     String
  image        String?
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

enum RecipeSourceType {
  SPOONACULAR
  USER_UPLOAD
  EXTERNAL_API
  MANUAL_ENTRY
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}
